<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SavorReader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SavorReader.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SavorReader.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibility" />

        <DataTemplate x:Key="BookGridTemplate" x:DataType="vm:BookItemViewModel">
            <Grid Width="176" Margin="6" ToolTipService.ToolTip="{x:Bind Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Height="232"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <TextBlock
                            Margin="16"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="4"
                            TextTrimming="CharacterEllipsis"
                            Opacity="0.45"
                            Text="{x:Bind Title}" />
                        <Image
                            Source="{x:Bind CoverImage}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind CoverVisibility}" />
                        <Border
                            Margin="8"
                            Padding="7,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Bind FormatText}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    Margin="2,9,2,0"
                    FontWeight="SemiBold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind Title}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="2,2,2,0"
                    FontSize="12"
                    Opacity="0.65"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind AuthorText}" />

                <Grid Grid.Row="3" Margin="2,7,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        Height="3"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Value="{x:Bind ProgressPercent}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontSize="11"
                        Opacity="0.65"
                        Text="{x:Bind ProgressText}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BookListTemplate" x:DataType="vm:BookItemViewModel">
            <Grid Padding="8,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="48"
                    Height="64"
                    CornerRadius="6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <Grid>
                        <TextBlock
                            FontSize="9"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Opacity="0.35"
                            Text="{x:Bind FormatText}" />
                        <Image
                            Source="{x:Bind CoverImage}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind CoverVisibility}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind AuthorText}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.5"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Text="{x:Bind TagsText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                    <ProgressBar Height="3" Maximum="100" Value="{x:Bind ProgressPercent}" />
                    <TextBlock
                        FontSize="11"
                        Opacity="0.65"
                        Text="{x:Bind ProgressText}" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Opacity="0.7"
                        Text="{x:Bind FormatText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Opacity="0.6"
                        Text="{x:Bind StatusText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,18,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="书库" />
                <TextBlock
                    FontSize="12"
                    Opacity="0.6"
                    Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8">
                <Button
                    x:Name="ViewButton"
                    Click="ViewToggle_Click"
                    Content="切换视图" />
                <Button
                    Command="{x:Bind ViewModel.ScanFolderCommand}"
                    Content="扫描文件夹" />
                <Button
                    Command="{x:Bind ViewModel.ImportFilesCommand}"
                    Content="导入书籍"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                Severity="Informational" />

            <TextBox
                x:Name="SearchBox"
                Width="320"
                HorizontalAlignment="Left"
                PlaceholderText="搜索标题、作者、文件名或标签"
                TextChanged="SearchBox_TextChanged" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="StatusFilterBox"
                    Width="128"
                    SelectedIndex="0"
                    SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="全部状态" Tag="" />
                    <ComboBoxItem Content="未读" Tag="unread" />
                    <ComboBoxItem Content="阅读中" Tag="reading" />
                    <ComboBoxItem Content="已读" Tag="finished" />
                </ComboBox>
                <ComboBox
                    x:Name="TagFilterBox"
                    Width="128"
                    PlaceholderText="全部标签"
                    ItemsSource="{x:Bind ViewModel.AllTags}"
                    SelectionChanged="TagFilter_SelectionChanged" />
                <ComboBox
                    x:Name="SortFilterBox"
                    Width="128"
                    SelectedIndex="0"
                    SelectionChanged="SortFilter_SelectionChanged">
                    <ComboBoxItem Content="最近阅读" Tag="recent" />
                    <ComboBoxItem Content="最近加入" Tag="added" />
                    <ComboBoxItem Content="按标题" Tag="title" />
                    <ComboBoxItem Content="按作者" Tag="author" />
                </ComboBox>
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    MaxWidth="260"
                    TextTrimming="CharacterEllipsis"
                    Opacity="0.65"
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Grid>
                <GridView
                    x:Name="BooksGrid"
                    Padding="0,4,0,0"
                    IsItemClickEnabled="True"
                    ItemTemplate="{StaticResource BookGridTemplate}"
                    ItemsSource="{x:Bind ViewModel.VisibleBooks}"
                    SelectedItem="{x:Bind ViewModel.SelectedBook, Mode=TwoWay}"
                    SelectionMode="Single"
                    DoubleTapped="BooksGrid_DoubleTapped" />

                <ListView
                    x:Name="BooksList"
                    Padding="0,4,0,0"
                    Visibility="Collapsed"
                    ItemTemplate="{StaticResource BookListTemplate}"
                    ItemsSource="{x:Bind ViewModel.VisibleBooks}"
                    SelectedItem="{x:Bind ViewModel.SelectedBook, Mode=TwoWay}"
                    SelectionMode="Single"
                    DoubleTapped="BooksList_DoubleTapped" />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasVisibleBooks, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="40"
                        Opacity="0.3"
                        Glyph="&#xE8F1;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="书库还是空的" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Opacity="0.6"
                        Text="导入 EPUB/PDF，或扫描一个文件夹" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Column="1"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        DataContext="{x:Bind ViewModel.SelectedBook, Mode=OneWay}"
                        Spacing="10">
                        <Grid Height="150" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <TextBlock
                                        Margin="8"
                                        FontSize="10"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Opacity="0.4"
                                        Text="{Binding FormatText}" />
                                    <Image
                                        Source="{Binding CoverImage}"
                                        Stretch="UniformToFill"
                                        Visibility="{Binding CoverVisibility}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap"
                                    MaxLines="3"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    FontSize="13"
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Text="{Binding AuthorText}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontSize="11" Opacity="0.6" Text="{Binding FormatText}" />
                                    <TextBlock FontSize="11" Opacity="0.6" Text="{Binding PageCountText}" />
                                </StackPanel>
                                <ProgressBar
                                    Height="4"
                                    Maximum="100"
                                    Value="{Binding ProgressPercent}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            FontSize="12"
                            Opacity="0.7"
                            TextWrapping="Wrap"
                            Text="{Binding DescriptionText}" />

                        <StackPanel Spacing="3">
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding PublisherText}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding LanguageText}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding LastOpenedText}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding LocationText}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding FileName}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="标签" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,4,4"
                                            Padding="7,3"
                                            CornerRadius="10"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock FontSize="11" Text="{Binding}" />
                                                <Button
                                                    Width="16"
                                                    Height="16"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Content="×"
                                                    FontSize="10"
                                                    Tag="{Binding}"
                                                    Click="RemoveTag_Click" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBox
                                    x:Name="NewTagBox"
                                    Width="180"
                                    PlaceholderText="输入新标签" />
                                <Button Click="AddTag_Click" Content="添加" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="阅读状态" />
                            <ComboBox
                                x:Name="StatusCombo"
                                SelectionChanged="StatusCombo_SelectionChanged">
                                <ComboBoxItem Content="未读" Tag="unread" />
                                <ComboBoxItem Content="阅读中" Tag="reading" />
                                <ComboBoxItem Content="已读" Tag="finished" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="OpenBook_Click"
                                Content="{Binding OpenButtonText}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="OpenExternal_Click"
                                Content="用其他应用打开"
                                Visibility="{Binding IsPdf, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="RevealFile_Click"
                                Content="在资源管理器中显示" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Click="RemoveBook_Click"
                                Content="从书库移除" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
