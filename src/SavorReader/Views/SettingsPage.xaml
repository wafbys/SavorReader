<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SavorReader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,18,24,24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="14">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="数据目录" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.65"
                        Text="书库数据库、书籍副本、封面、EPUB 缓存和 WebView2 数据都保存在执行文件旁的 Data 目录。" />
                    <TextBlock
                        x:Name="DataPathText"
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OpenDataFolder_Click" Content="打开数据目录" />
                        <Button Click="OpenLogs_Click" Content="查看日志" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="瘦身" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap"
                        Text="清理 EPUB 解压缓存、未引用的书籍副本/封面和日志。书库中正在使用的书籍和封面不会被删除；WebView2 浏览器缓存会在下次启动时清理。" />
                    <TextBlock
                        x:Name="SlimmingSummaryText"
                        FontSize="12"
                        LineHeight="19"
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SlimmingScanButton"
                            Click="RefreshSlimming_Click"
                            Content="重新扫描" />
                        <Button
                            x:Name="SlimmingCleanButton"
                            Click="CleanSlimming_Click"
                            Content="立即瘦身"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" />
                        <ProgressRing
                            x:Name="SlimmingProgress"
                            Width="20"
                            Height="20"
                            IsActive="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="阅读设置" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap"
                        Text="字体、字号、行距、边距和日间/夜间主题在 EPUB 阅读器的“阅读设置”中调整，并全局保存。" />
                </StackPanel>
            </Border>

            <Border
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="关于" />
                    <TextBlock
                        x:Name="AboutVersionText"
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.55"
                        TextWrapping="Wrap"
                        Text="查看运行环境、数据目录、开源许可证和范围说明。" />
                    <Button Click="OpenAbout_Click" Content="打开关于页" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
