<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SavorReader.Views.EpubReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SavorReader.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="10,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    AutomationProperties.Name="返回书库"
                    Click="Back_Click"
                    ToolTipService.ToolTip="返回书库">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE72B;" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="AuthorText"
                        FontSize="11"
                        Opacity="0.6"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <TextBlock
                        x:Name="ProgressText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.65"
                        Text="0%" />

                    <Button x:Name="TocButton" Content="目录">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ListView
                                    x:Name="TocList"
                                    Width="380"
                                    MaxHeight="520"
                                    SelectionChanged="TocList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TocItemViewModel">
                                            <TextBlock
                                                Margin="{x:Bind Indent}"
                                                Text="{x:Bind Title}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="阅读设置">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <ComboBox
                                        x:Name="FontCombo"
                                        Header="字体"
                                        SelectedIndex="0"
                                        SelectionChanged="SettingsControl_Changed">
                                        <ComboBoxItem Content="衬线（宋体风格）" />
                                        <ComboBoxItem Content="无衬线（黑体风格）" />
                                    </ComboBox>
                                    <Slider
                                        x:Name="FontSizeSlider"
                                        Header="字号"
                                        Minimum="12"
                                        Maximum="30"
                                        StepFrequency="1"
                                        Value="18"
                                        ValueChanged="SettingsSlider_Changed" />
                                    <Slider
                                        x:Name="LineHeightSlider"
                                        Header="行距"
                                        Minimum="1.2"
                                        Maximum="2.2"
                                        StepFrequency="0.1"
                                        Value="1.7"
                                        ValueChanged="SettingsSlider_Changed" />
                                    <Slider
                                        x:Name="MarginSlider"
                                        Header="页边距"
                                        Minimum="16"
                                        Maximum="96"
                                        StepFrequency="4"
                                        Value="48"
                                        ValueChanged="SettingsSlider_Changed" />
                                    <ToggleSwitch
                                        x:Name="NightToggle"
                                        Header="夜间模式"
                                        Toggled="NightToggle_Toggled" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="ResetSettings_Click"
                                        Content="恢复默认" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="ThemeButton"
                        Click="ThemeButton_Click"
                        Content="夜间" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <WebView2 x:Name="ReaderWebView" />

            <Grid
                x:Name="LoadingOverlay"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <ProgressRing Width="32" Height="32" IsActive="True" />
                    <TextBlock
                        FontSize="13"
                        Opacity="0.65"
                        Text="正在准备 EPUB…" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="ErrorOverlay"
                Padding="40"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <TextBlock
                        x:Name="ErrorText"
                        MaxWidth="620"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="Back_Click"
                        Content="返回书库" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
